# Copy to .env (gitignored) and fill in. cwf loads it at startup; shell variables win.
# Never commit .env.

# Option A (recommended): a named profile from ~/.aws/config (SSO or keys live there)
AWS_PROFILE=your-profile-name

# Option B: static keys for a READ-ONLY IAM user (see iam/read-only-policy.json, step 8)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_DEFAULT_REGION=ap-southeast-1

# Optional: "Prepared by" block on PDF/HTML reports (cwf web). Leave empty to hide it.
# CWF_PREPARED_BY=Your Name
# CWF_PREPARED_BY_TITLE=DevOps Engineer | AWS Cost Optimization
# CWF_CONTACT_EMAIL=you@example.com
# CWF_LINKEDIN_URL=https://www.linkedin.com/in/your-profile/
