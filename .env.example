# Copy to .env (gitignored) and fill in. cwf loads it at startup; shell variables win.
# Never commit .env.

# Option A (recommended): a named profile from ~/.aws/config (SSO or keys live there)
AWS_PROFILE=your-profile-name

# Option B: static keys for a READ-ONLY IAM user (see iam/read-only-policy.json, step 8)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_DEFAULT_REGION=ap-southeast-1
