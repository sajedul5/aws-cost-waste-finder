{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCwfScanFromConsultantAccount",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<CONSULTANT-ACCOUNT-ID>:role/<CONSULTANT-ROLE-NAME>"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "<EXTERNAL-ID>"
        }
      }
    }
  ]
}
